{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only bundled main UI may listen to host events. OS operations use validated Rust commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-window-minimize",
    "allow-window-maximize",
    "allow-window-close",
    "allow-window-start-dragging",
    "allow-window-get-size",
    "allow-window-is-fullscreen",
    "allow-window-enter-fullscreen",
    "allow-window-leave-fullscreen",
    "allow-app-quit",
    "allow-power-sleep",
    "allow-power-shutdown",
    "allow-discord-set",
    "allow-discord-clear",
    "allow-runtime-versions",
    "allow-runtime-debug",
    "allow-open-link",
    "allow-notify-send",
    "allow-debug-send",
    "allow-updater-check",
    "allow-updater-install",
    "allow-settings-get-all",
    "allow-settings-get",
    "allow-settings-set",
    "allow-proxy-toggle",
    "allow-net-fetch",
    "allow-oauth-exchange",
    "allow-oauth-refresh",
    "allow-sibnet-parse",
    "allow-offline-get-library",
    "allow-offline-get-active-downloads",
    "allow-offline-download-episode",
    "allow-offline-pause-download",
    "allow-offline-resume-download",
    "allow-offline-retry-download",
    "allow-offline-cancel-download",
    "allow-offline-delete-episode",
    "allow-offline-open-folder",
    "allow-download-episode",
    "allow-media-open",
    "allow-media-close",
    "allow-offline-open",
    "allow-account-start",
    "allow-account-poll",
    "allow-account-cancel",
    "allow-account-status",
    "allow-account-logout",
    "allow-account-portal",
    "allow-friends-list",
    "allow-friends-lookup",
    "allow-friends-request",
    "allow-friends-accept",
    "allow-friends-reject",
    "allow-friends-remove",
    "allow-watch-invites-list",
    "allow-watch-invite-send",
    "allow-watch-invite-accept",
    "allow-watch-invite-decline"
  ]
}
