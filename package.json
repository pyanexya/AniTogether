{
  "name": "anixartix",
  "version": "0.1.1",
  "description": "Independent anime desktop client with private watch-together rooms",
  "scripts": {
    "test": "vitest run --maxWorkers=2",
    "start": "sirv public --no-clear",
    "dev": "rollup -c -w --bundleConfigAsCjs",
    "build": "rollup -c --bundleConfigAsCjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "make:windows": "tauri build --target x86_64-pc-windows-msvc",
    "test:relay": "npm test --prefix server"
  },
  "keywords": [
    "anixart"
  ],
  "author": "AnixArtix contributors; based on AniXFlow by MjKey",
  "license": "GPL-2.0-only",
  "devDependencies": {
    "@babichjacob/svelte-localstorage": "2.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tauri-apps/cli": "2.12.4",
    "lottie-svelte": "^1.3.7",
    "rollup": "^4.62.2",
    "rollup-plugin-css-only": "^4.5.5",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-string": "^3.0.0",
    "rollup-plugin-svelte": "^7.2.3",
    "sirv-cli": "^3.0.1",
    "svelte": "^5.56.7",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "anime4k-webgpu": "^1.0.0",
    "anixartjs": "^0.1.8"
  },
  "productName": "AnixArtix"
}
